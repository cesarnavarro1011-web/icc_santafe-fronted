// ============================================================
//  Espacio de estudio · ICC Santa Fe
//  Migración del sistema Google Apps Script + Sheets a Postgres.
//  Cada modelo indica la hoja de origen del Excel.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum Rol {
  SUPERADMIN
  PASTOR
  SUPERVISOR
  LIDER
  MAESTRO
  ESTUDIANTE
  EDITOR // gestor de contenido de la página web
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_LIBRE
}

enum TipoBautismo {
  AGUA
  ESPIRITU
}

enum TipoServicio {
  DOMINGO
  MIERCOLES
  GV
  ESPECIAL
  OTRO
}

enum TipoActividad {
  TAREA
  EXAMEN
  MATERIAL
  CLASE
}

enum EstadoMatricula {
  EN_PROGRESO
  APROBADO
  REPROBADO
  VENCIDO
  RETIRADO
}

enum EstadoEntrega {
  ENVIADA
  APROBADA
  REPROBADA
  DEVUELTA
}

enum EstadoPago {
  PENDIENTE
  ABONO
  COMPLETADO
  EXENTO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  NEQUI
  DAVIPLATA
  EXENTO
  MERCADOPAGO
}

enum TipoDescuento {
  PORCENTAJE
  VALOR
}

enum RolMaestro {
  TITULAR
  AUXILIAR
}

enum EstadoCertificado {
  EN_FIRMA
  EMITIDO
  ANULADO
}

enum TipoOfrenda {
  DIEZMO
  OFRENDA
  PRIMICIA
  PRO_TEMPLO
  MISIONES
  ACCION_GRACIAS
  OTRO
}

enum EstadoOfrenda {
  PENDIENTE // registrado por el líder, falta revisión del pastor
  VERIFICADO
  OBSERVADO // el pastor encontró algo que revisar
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
}

enum EstadoPeticion {
  NUEVA
  EN_ORACION
  RESPONDIDA
  ARCHIVADA
}

enum PropositoOtp {
  CAMBIO_PASSWORD
  LOGIN_2FA // verificación en dos pasos (WhatsApp o correo)
}

// ── Personas y acceso ────────────────────────────────────────

/// Hoja "Fieles"
model Fiel {
  id                 String         @id @default(cuid())
  codigo             String         @unique // "F-1004355591" (ID del sistema anterior)
  nombre             String
  apellido           String
  fechaNacimiento    DateTime?      @db.Date
  estadoCivil        EstadoCivil?
  bautizado          Boolean        @default(false)
  celular            String?
  direccion          String?
  correo             String?
  estado             EstadoRegistro @default(ACTIVO)
  /// false = se dio de baja de los comunicados masivos (los avisos de sus cursos y pagos sí le llegan)
  recibeInformativos Boolean        @default(true)
  grupoId            String? // grupo del líder al que pertenece
  grupo              Grupo?         @relation("MiembrosGrupo", fields: [grupoId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  usuario                Usuario?
  gruposQueLidera        Grupo[]                    @relation("LiderGrupo")
  ofrendasRegistradas    RegistroOfrenda[]          @relation("OfrendaRegistrador")
  bautismos              Bautismo[]
  asistencias            AsistenciaCongregacional[]
  inscripciones          Inscripcion[]
  matriculas             Matricula[]                @relation("MatriculaEstudiante")
  matriculasComoMaestro  Matricula[]                @relation("MatriculaMaestro")
  matriculasSupervisa    Matricula[]                @relation("MatriculaSupervisor")
  asignacionesMaestro    AsignacionMaestro[]
  asignacionesSupervisor AsignacionSupervisor[]
  entregas               Entrega[]                  @relation("EntregaEstudiante")
  entregasRevisadas      Entrega[]                  @relation("EntregaRevisor")
  notas                  Nota[]
  intentosExamen         IntentoExamen[]
  asistenciasCurso       AsistenciaCurso[]
  certificados           Certificado[]              @relation("CertificadoEstudiante")
  areas                  MiembroArea[]
  eventos                EventoEspecial[]

  @@index([apellido, nombre])
}

/// Hoja "Credenciales_Acceso"
model Usuario {
  id                  String    @id @default(cuid())
  fielId              String    @unique
  fiel                Fiel      @relation(fields: [fielId], references: [id], onDelete: Cascade)
  usuario             String    @unique
  /// bcrypt. Los hashes SHA-256 del sistema viejo se guardan con prefijo "sha256:"
  /// y se convierten a bcrypt en el primer inicio de sesión exitoso.
  passwordHash        String
  rol                 Rol       @default(ESTUDIANTE)
  debeCambiarPassword Boolean   @default(true) // columna "Temp"
  activo              Boolean   @default(true)
  firmaPath           String? // firma digital PNG (ruta relativa en STORAGE_DIR)
  ultimoAcceso        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  otps         OtpCode[]
  dispositivos DispositivoConfiable[]
}

/// Dispositivo/navegador donde el usuario ya verificó el código de WhatsApp.
/// Mientras la verificación sea reciente (30 días) no se vuelve a pedir.
model DispositivoConfiable {
  id                 String   @id @default(cuid())
  usuarioId          String
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash          String // SHA-256 del identificador guardado en el navegador
  nombre             String? // navegador / sistema (para mostrarlo en el perfil)
  ultimaVerificacion DateTime @default(now())
  ultimoUso          DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([usuarioId, tokenHash])
}

/// Reemplaza CacheService "OTP_CHANGE_<id>"
model OtpCode {
  id        String       @id @default(cuid())
  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codeHash  String
  proposito PropositoOtp
  intentos  Int          @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([usuarioId, proposito])
}

// ── Vida congregacional ──────────────────────────────────────

/// Hoja "Bautismos"
model Bautismo {
  id              String       @id @default(cuid())
  fielId          String
  fiel            Fiel         @relation(fields: [fielId], references: [id], onDelete: Cascade)
  fecha           DateTime     @db.Date
  ministro        String?
  lugar           String?
  tipo            TipoBautismo @default(AGUA)
  certificadoPath String?
  createdAt       DateTime     @default(now())
}

/// Hoja "Asistencias" (asistencia a servicios de la iglesia)
model AsistenciaCongregacional {
  id              String       @id @default(cuid())
  fecha           DateTime     @default(now())
  fielId          String? // null = invitado
  fiel            Fiel?        @relation(fields: [fielId], references: [id], onDelete: SetNull)
  nombreInvitado  String?
  servicio        TipoServicio
  registradoPorId String?
  createdAt       DateTime     @default(now())

  @@index([fecha])
}

/// Grupo de un líder: sus fieles. Por turnos semanales registra la asistencia de los servicios.
model Grupo {
  id          String         @id @default(cuid())
  nombre      String         @unique
  descripcion String?
  liderId     String?
  lider       Fiel?          @relation("LiderGrupo", fields: [liderId], references: [id], onDelete: SetNull)
  estado      EstadoRegistro @default(ACTIVO)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  miembros Fiel[]            @relation("MiembrosGrupo")
  turnos   TurnoAsistencia[]
  ofrendas RegistroOfrenda[]
}

/// Cronograma: a qué grupo le toca registrar la asistencia cada semana (lunes a domingo)
model TurnoAsistencia {
  id          String   @id @default(cuid())
  semana      DateTime @db.Date // lunes de la semana
  grupoId     String
  grupo       Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  notas       String?
  creadoPorId String?
  createdAt   DateTime @default(now())

  @@unique([grupoId, semana])
  @@index([semana])
}

/// Hoja "Areas_Inscritas"
model Area {
  id       String         @id @default(cuid())
  nombre   String         @unique
  estado   EstadoRegistro @default(ACTIVO)
  miembros MiembroArea[]
}

model MiembroArea {
  id        String   @id @default(cuid())
  fielId    String
  fiel      Fiel     @relation(fields: [fielId], references: [id], onDelete: Cascade)
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  cargo     String?
  createdAt DateTime @default(now())

  @@unique([fielId, areaId])
}

/// Hoja "Eventos_Especiales"
model EventoEspecial {
  id          String    @id @default(cuid())
  fielId      String
  fiel        Fiel      @relation(fields: [fielId], references: [id], onDelete: Cascade)
  tipo        String?
  nombre      String?
  fechaInicio DateTime?
  lugar       String?
  estado      String?
  createdAt   DateTime  @default(now())
}

// ── Académico ────────────────────────────────────────────────

/// Hoja "Cursos_Catalogo"
model Curso {
  id           String         @id @default(cuid())
  codigo       String         @unique // "TEOL-1"
  nombre       String
  nivel        Int?
  descripcion  String?
  estado       EstadoRegistro @default(ACTIVO)
  duracionDias Int            @default(90)
  costo        Decimal        @default(0) @db.Decimal(12, 2)
  imagenPath   String? // portada del curso (disco local); sin ella se usa el degradado
  diasClase    Int[]          @default([]) // días de clase: 0 domingo … 6 sábado
  horaInicio   String? // "18:00"
  horaFin      String? // "20:00"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  actividades   Actividad[]
  maestros      AsignacionMaestro[]
  supervisores  AsignacionSupervisor[]
  inscripciones Inscripcion[]
  matriculas    Matricula[]
  preguntas     Pregunta[]
  sesiones      SesionClase[]
  certificados  Certificado[]
  promociones   CodigoPromocion[]
}

/// Hoja "Catalogo_Actividades"
model Actividad {
  id            String        @id @default(cuid())
  codigo        String        @unique // "ACT-001"
  cursoId       String
  curso         Curso         @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nivel         Int           @default(1)
  tipo          TipoActividad @default(TAREA)
  nombre        String
  notaMax       Float         @default(10)
  peso          Float         @default(100) // Porcentaje_Peso
  linkMaterial  String?
  materialPath  String? // material subido al disco local
  instrucciones String?
  orden         Int           @default(0)
  createdAt     DateTime      @default(now())

  entregas  Entrega[]
  notas     Nota[]
  intentos  IntentoExamen[]
  preguntas Pregunta[]

  @@index([cursoId, nivel])
}

/// Hoja "Maestros_Asignados"
model AsignacionMaestro {
  id        String     @id @default(cuid())
  fielId    String
  fiel      Fiel       @relation(fields: [fielId], references: [id], onDelete: Cascade)
  cursoId   String
  curso     Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nivel     Int? // null = todos los niveles
  rol       RolMaestro @default(TITULAR)
  createdAt DateTime   @default(now())

  @@unique([fielId, cursoId, nivel])
}

/// Hoja "Supervisores_Niveles"
model AsignacionSupervisor {
  id              String         @id @default(cuid())
  fielId          String
  fiel            Fiel           @relation(fields: [fielId], references: [id], onDelete: Cascade)
  cursoId         String
  curso           Curso          @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nivelAutorizado String         @default("Todos")
  estado          EstadoRegistro @default(ACTIVO)
  createdAt       DateTime       @default(now())

  @@unique([fielId, cursoId])
}

/// Hoja "Inscripciones_Pagos"
model Inscripcion {
  id              String           @id @default(cuid())
  codigo          String           @unique // "INS-382586"
  fielId          String
  fiel            Fiel             @relation(fields: [fielId], references: [id], onDelete: Cascade)
  cursoId         String
  curso           Curso            @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  fecha           DateTime         @default(now())
  costoTotal      Decimal          @default(0) @db.Decimal(12, 2)
  montoPagado     Decimal          @default(0) @db.Decimal(12, 2)
  estadoPago      EstadoPago       @default(PENDIENTE)
  metodoPago      MetodoPago?
  comprobantePath String?
  registradoPorId String?
  // Descuento por código de promoción (costoTotal es el valor del curso; se cobra costoTotal - descuento)
  descuento       Decimal          @default(0) @db.Decimal(12, 2)
  codigoPromoId   String?
  codigoPromo     CodigoPromocion? @relation(fields: [codigoPromoId], references: [id], onDelete: SetNull)
  // Mercado Pago
  mpPreferenciaId String?
  mpPagoId        String?          @unique
  mpEstado        String? // approved, pending, in_process, rejected…
  createdAt       DateTime         @default(now())

  @@index([fielId])
}

/// Códigos de descuento que crea el pastor para la inscripción a cursos
model CodigoPromocion {
  id          String        @id @default(cuid())
  codigo      String        @unique // en mayúsculas, ej. "JOVENES2026"
  descripcion String?
  tipo        TipoDescuento @default(PORCENTAJE)
  valor       Decimal       @db.Decimal(12, 2) // % (1-100) o pesos
  cursoId     String? // null = sirve para todos los cursos
  curso       Curso?        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  usosMax     Int? // null = ilimitado
  usos        Int           @default(0) // se cuenta cuando el pago queda aprobado
  validoDesde DateTime?
  validoHasta DateTime?
  activo      Boolean       @default(true)
  creadoPorId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  inscripciones Inscripcion[]
}

/// Hojas "Control_Academico" + "Cursos_Historico" (unificadas)
model Matricula {
  id                String          @id @default(cuid())
  codigo            String          @unique // "MAT-34385477"
  fielId            String
  fiel              Fiel            @relation("MatriculaEstudiante", fields: [fielId], references: [id], onDelete: Cascade)
  cursoId           String
  curso             Curso           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  maestroId         String?
  maestro           Fiel?           @relation("MatriculaMaestro", fields: [maestroId], references: [id], onDelete: SetNull)
  supervisorId      String?
  supervisor        Fiel?           @relation("MatriculaSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  fechaInicio       DateTime        @default(now())
  fechaVencimiento  DateTime?
  progreso          Int             @default(0) // Progreso_%
  notaFinal         Float           @default(0)
  estado            EstadoMatricula @default(EN_PROGRESO)
  aprobadoMaestroAt DateTime? // antes "Aprobado_Maestro" en Cursos_Historico
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  entregas     Entrega[]
  notas        Nota[]
  intentos     IntentoExamen[]
  certificados Certificado[]

  @@unique([fielId, cursoId])
}

/// Hoja "Entregas_Tareas"
model Entrega {
  id            String        @id @default(cuid())
  matriculaId   String
  matricula     Matricula     @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  fielId        String
  fiel          Fiel          @relation("EntregaEstudiante", fields: [fielId], references: [id], onDelete: Cascade)
  actividadId   String
  actividad     Actividad     @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  archivoPath   String? // PDF en disco local
  archivoNombre String?
  linkExterno   String? // entregas migradas con link de Drive
  estado        EstadoEntrega @default(ENVIADA)
  comentario    String?
  revisadoPorId String?
  revisadoPor   Fiel?         @relation("EntregaRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoAt    DateTime?
  fechaEntrega  DateTime      @default(now())

  nota Nota?

  @@index([actividadId, estado])
}

/// Hoja "Notas_Detalle"
model Nota {
  id              String         @id @default(cuid())
  matriculaId     String
  matricula       Matricula      @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  fielId          String
  fiel            Fiel           @relation(fields: [fielId], references: [id], onDelete: Cascade)
  actividadId     String
  actividad       Actividad      @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  entregaId       String?        @unique
  entrega         Entrega?       @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  intentoExamenId String?        @unique
  intentoExamen   IntentoExamen? @relation(fields: [intentoExamenId], references: [id], onDelete: SetNull)
  nota            Float
  notaMax         Float          @default(10)
  comentario      String?
  fecha           DateTime       @default(now())

  /// Una sola nota vigente por actividad y matrícula (la última calificación reemplaza la anterior)
  @@unique([matriculaId, actividadId])
}

/// Hoja "Banco_Preguntas"
model Pregunta {
  id                String     @id @default(cuid())
  codigo            String     @unique // "PQ-123456"
  cursoId           String
  curso             Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nivel             Int        @default(1)
  actividadId       String? // examen específico (opcional)
  actividad         Actividad? @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  pregunta          String
  respuestaCorrecta String
  puntos            Float      @default(1)
  createdAt         DateTime   @default(now())

  @@index([cursoId, nivel])
}

/// Antes: fila "Examen" en Entregas_Tareas con el detalle en JSON
model IntentoExamen {
  id              String    @id @default(cuid())
  matriculaId     String
  matricula       Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  fielId          String
  fiel            Fiel      @relation(fields: [fielId], references: [id], onDelete: Cascade)
  actividadId     String
  actividad       Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  /// [{ preguntaId, pregunta, respuestaCorrecta, respuesta, puntos, correcto }]
  detalle         Json
  puntosObtenidos Float
  puntosTotal     Float
  notaAutomatica  Float
  notaManual      Float?
  motivoEdicion   String?
  editadoPorId    String?
  createdAt       DateTime  @default(now())

  nota Nota?

  @@index([actividadId])
}

/// Hoja "Control_Asistencias_Cursos" (normalizada: una sesión = fecha + nivel)
model SesionClase {
  id          String   @id @default(cuid())
  cursoId     String
  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  nivel       Int      @default(1)
  fecha       DateTime @db.Date
  tema        String?
  creadaPorId String?
  createdAt   DateTime @default(now())

  asistencias AsistenciaCurso[]

  @@unique([cursoId, nivel, fecha])
}

model AsistenciaCurso {
  id        String      @id @default(cuid())
  sesionId  String
  sesion    SesionClase @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  fielId    String
  fiel      Fiel        @relation(fields: [fielId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([sesionId, fielId])
}

/// Hoja "Certificados_Emitidos". Flujo: Maestro → Supervisor → Pastor → PDF
model Certificado {
  id                String            @id @default(cuid())
  codigo            String            @unique // "CERT-12345678"
  fielId            String
  fiel              Fiel              @relation("CertificadoEstudiante", fields: [fielId], references: [id], onDelete: Cascade)
  cursoId           String
  curso             Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  matriculaId       String?
  matricula         Matricula?        @relation(fields: [matriculaId], references: [id], onDelete: SetNull)
  firmaMaestroId    String?
  firmaMaestroAt    DateTime?
  firmaSupervisorId String?
  firmaSupervisorAt DateTime?
  firmaPastorId     String?
  firmaPastorAt     DateTime?
  estado            EstadoCertificado @default(EN_FIRMA)
  pdfPath           String?
  linkExterno       String? // diplomas migrados desde Drive
  emitidoAt         DateTime?
  createdAt         DateTime          @default(now())

  @@unique([fielId, cursoId])
}

/// Hoja "Log_Envios" (correos que no se pudieron enviar)
enum EstadoComunicado {
  BORRADOR
  ENVIANDO
  ENVIADO
}

enum CanalEnvio {
  CORREO
  WHATSAPP
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  FALLIDO
  OMITIDO // sin correo/celular o dado de baja
}

/// Aviso informativo masivo (correo y/o WhatsApp) — módulo "Comunicados"
model Comunicado {
  id            String           @id @default(cuid())
  asunto        String
  cuerpo        String // texto; admite **negrita**, enlaces y {{nombre}}
  imagenes      String[]         @default([]) // rutas en STORAGE_DIR/comunicados/<id>/
  enlaceUrl     String? // botón opcional
  enlaceTexto   String?
  porCorreo     Boolean          @default(true)
  porWhatsapp   Boolean          @default(false)
  /// { tipo: "todos" | "rol" | "grupo" | "curso" | "cargo", valor?: string }
  destinatarios Json             @default("{\"tipo\":\"todos\"}")
  estado        EstadoComunicado @default(BORRADOR)
  total         Int              @default(0)
  enviados      Int              @default(0)
  fallidos      Int              @default(0)
  omitidos      Int              @default(0)
  creadoPorId   String?
  enviadoAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  envios EnvioComunicado[]
}

/// Un envío de un comunicado a una persona por un canal (para progreso y reintentos)
model EnvioComunicado {
  id           String      @id @default(cuid())
  comunicadoId String
  comunicado   Comunicado  @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  fielId       String
  canal        CanalEnvio
  destino      String?
  estado       EstadoEnvio @default(PENDIENTE)
  error        String?
  enviadoAt    DateTime?

  @@unique([comunicadoId, fielId, canal])
  @@index([comunicadoId, estado])
}

model LogEnvio {
  id        String   @id @default(cuid())
  destino   String?
  asunto    String
  tipo      String
  estado    String   @default("PENDIENTE")
  error     String?
  createdAt DateTime @default(now())
}

/// Diezmos, ofrendas y demás recaudos por servicio. Los registra el líder; el pastor los verifica.
model RegistroOfrenda {
  id              String        @id @default(cuid())
  fecha           DateTime      @db.Date
  servicio        TipoServicio
  tipo            TipoOfrenda
  metodo          MetodoPago    @default(EFECTIVO)
  monto           Decimal       @db.Decimal(14, 2)
  descripcion     String? // para "Otro" o aclaraciones
  registradoPorId String
  registradoPor   Fiel          @relation("OfrendaRegistrador", fields: [registradoPorId], references: [id], onDelete: Restrict)
  grupoId         String?
  grupo           Grupo?        @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  estado          EstadoOfrenda @default(PENDIENTE)
  verificadoPorId String?
  verificadoAt    DateTime?
  observacion     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fecha])
  @@index([registradoPorId])
}

// ── Página web pública (lo administra el Gestor de contenido) ──

/// Diapositivas del carrusel de la portada
model WebSlide {
  id            String            @id @default(cuid())
  titulo        String
  subtitulo     String?
  descripcion   String?
  imagenPath    String? // subida al disco (STORAGE_DIR/web/...)
  imagenUrl     String? // o una imagen de /public
  ctaTexto      String?
  ctaLink       String?
  orden         Int               @default(0)
  estado        EstadoPublicacion @default(BORRADOR)
  publicarDesde DateTime?
  publicarHasta DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// Barra de anuncio destacada del sitio
model WebAnuncio {
  id            String            @id @default(cuid())
  texto         String
  enlace        String?
  textoEnlace   String?
  color         String            @default("violeta")
  estado        EstadoPublicacion @default(BORRADOR)
  publicarDesde DateTime?
  publicarHasta DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WebEvento {
  id          String            @id @default(cuid())
  titulo      String
  descripcion String
  fecha       DateTime          @db.Date
  hora        String // "19:00"
  lugar       String
  categoria   String            @default("evento-especial")
  recurrente  Boolean           @default(false)
  destacado   Boolean           @default(false)
  imagenPath  String?
  imagenUrl   String?
  estado      EstadoPublicacion @default(BORRADOR)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([fecha])
}

model WebPredica {
  id          String            @id @default(cuid())
  titulo      String
  descripcion String?
  predicador  String
  fecha       DateTime          @db.Date
  videoUrl    String // YouTube o Vimeo
  serie       String?
  etiquetas   String[]          @default([])
  imagenPath  String? // miniatura propia; si no, la de YouTube
  destacada   Boolean           @default(false)
  vistas      Int               @default(0)
  estado      EstadoPublicacion @default(BORRADOR)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([fecha])
}

model WebMinisterio {
  id          String            @id @default(cuid())
  slug        String            @unique // "jovenes" → /ministerios/jovenes
  nombre      String
  descripcion String
  publico     String? // a quién va dirigido
  horario     String?
  lugar       String?
  lider       String?
  correo      String?
  imagenPath  String?
  imagenUrl   String?
  orden       Int               @default(0)
  estado      EstadoPublicacion @default(BORRADOR)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Datos generales de la iglesia para la web (una sola fila, id "principal").
/// Se muestran en el pie de página, Contáctanos y Nosotros.
model WebSitio {
  id                 String   @id @default("principal")
  nombre             String   @default("Iglesia Cuadrangular Santa Fe")
  lema               String?
  descripcion        String? // texto corto del pie de página
  // Contacto
  telefono           String?
  whatsapp           String?
  correo             String?
  direccion          String?
  ciudad             String?
  mapaUrl            String? // enlace de Google Maps
  emergencias        String? // teléfono pastoral para emergencias
  /// Bloques separados por una línea en blanco: primera línea = día, siguientes = horarios
  horarios           String?
  facebook           String?
  instagram          String?
  youtube            String?
  tiktok             String?
  // Nosotros
  nosotrosTitulo     String?
  nosotrosTexto      String?
  nosotrosImagenPath String?
  contactoImagenPath String? // fondo del encabezado de Contáctanos
  loginImagenPath    String? // imagen del lado derecho del inicio de sesión
  mision             String?
  vision             String?
  valores            String? // uno por línea
  /// [{ valor: "300+", etiqueta: "Miembros activos" }]
  estadisticas       Json     @default("[]")
  updatedAt          DateTime @updatedAt
}

/// Etapas de "Nuestra historia" (Nosotros)
model WebHistoria {
  id         String            @id @default(cuid())
  titulo     String
  periodo    String? // "1999 - 2005"
  texto      String
  imagenPath String?
  imagenUrl  String?
  orden      Int               @default(0)
  estado     EstadoPublicacion @default(PUBLICADO)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

/// Personas de Nosotros: sucesión pastoral (fundadores / actuales) y equipo pastoral
model WebPersona {
  id          String            @id @default(cuid())
  nombre      String
  cargo       String?
  descripcion String?
  seccion     String // "fundadores" | "actuales" | "equipo"
  imagenPath  String?
  imagenUrl   String?
  orden       Int               @default(0)
  estado      EstadoPublicacion @default(PUBLICADO)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([seccion, orden])
}

/// Peticiones de oración que envían los visitantes desde la página
model PeticionOracion {
  id        String         @id @default(cuid())
  nombre    String
  contacto  String? // celular o correo, opcional
  mensaje   String
  anonima   Boolean        @default(false)
  estado    EstadoPeticion @default(NUEVA)
  nota      String? // nota interna del equipo
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([estado, createdAt])
}

/// Diseño editable del certificado (una sola fila, id "principal"). Lo vacío usa el texto por defecto.
model PlantillaCertificado {
  id               String   @id @default("principal")
  institucion      String? // vacío = nombre de la iglesia (Datos de la iglesia)
  subtitulo        String?
  titulo           String?
  textoIntro       String?
  textoPrograma    String?
  versiculo        String?
  versiculoCita    String?
  mostrarVersiculo Boolean  @default(true)
  lugar            String? // vacío = ciudad de la iglesia
  cargoMaestro     String?
  cargoSupervisor  String?
  cargoPastor      String?
  logoPath         String? // vacío = logo de la iglesia
  selloPath        String?
  updatedAt        DateTime @updatedAt
}
