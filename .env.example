# ── Base de datos (PostgreSQL local) ─────────────────────────
# Formato: postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/icc_santafe?schema=public"

# ── Autenticación (next-auth) ────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo"

# ── Archivos (tareas, firmas, certificados) en disco local ───
# Reemplaza a Google Drive. Todo se guarda en esta carpeta de tu PC.
STORAGE_DIR="C:/ICC_SantaFe/storage"

# ── Correo ───────────────────────────────────────────────────
# Se usa para: pagos de cursos, acceso a cursos nuevos, recuperar contraseña,
# calificaciones, certificados y los Comunicados masivos.
# Si SMTP_HOST está vacío, los correos se imprimen en la consola del servidor.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu cuenta y SMTP_PASS una
#        "contraseña de aplicación" (Cuenta de Google → Seguridad → Verificación en 2 pasos →
#        Contraseñas de aplicaciones). Gmail permite ~500 correos/día; para más usa un
#        servicio como Brevo, Mailgun o Amazon SES (mismas 4 variables SMTP).
# Los enlaces de los correos ("Ir al curso", "darse de baja") usan NEXTAUTH_URL:
# en producción pon ahí la dirección pública del sitio (https://…).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Iglesia Cuadrangular Santa Fe <no-reply@iccsantafe.com>"

# ── WhatsApp (API oficial de Meta: WhatsApp Cloud API) ──────
# Se usa para: recuperar contraseña, verificación en dos pasos y Comunicados.
# Sin WHATSAPP_TOKEN los mensajes se imprimen en la consola del servidor.
# Pasos: developers.facebook.com → crear app "Business" → agregar WhatsApp →
#   copia el "Phone number ID" y genera un token PERMANENTE (usuario del sistema).
# Las plantillas se crean y aprueban en WhatsApp Manager → Plantillas de mensajes:
#   WHATSAPP_PLANTILLA       categoría "Authentication" (código con botón "Copiar código")
#   WHATSAPP_PLANTILLA_INFO  categoría "Utility" o "Marketing", cuerpo con 3 variables, p. ej.:
#       "Hola {{1}} 👋  *{{2}}*  {{3}}  — Iglesia Cuadrangular Santa Fe"
#     {{1}} = nombre, {{2}} = asunto del comunicado, {{3}} = mensaje
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_PLANTILLA="codigo_verificacion"
WHATSAPP_PLANTILLA_INFO="aviso_informativo"
WHATSAPP_IDIOMA="es"
WHATSAPP_PAIS="57"

# ── Verificación en dos pasos al iniciar sesión ─────────────
# Se pide un código solo en dispositivos nuevos o cada DOS_PASOS_DIAS días.
# Para desactivarla por completo: DOS_PASOS="desactivado"
DOS_PASOS_DIAS="30"

# ── Pagos en línea: Mercado Pago (Checkout Pro) ──────────────
# Credenciales en https://www.mercadopago.com.co/developers/panel → Tu aplicación → Credenciales.
#   Pruebas: token "TEST-…" (credenciales de prueba) · Producción: token "APP_USR-…"
# Webhook: en la misma aplicación → Webhooks → URL https://<tu-dominio>/api/publico/mercadopago/webhook,
#   evento "Pagos"; copia la "clave secreta" en MERCADOPAGO_WEBHOOK_SECRET.
# Sin token, en desarrollo el pago se simula con un botón (en producción queda deshabilitado).
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Certificados ─────────────────────────────────────────────
# Clave para los 2 caracteres de verificación del código de registro (ICCSF-2026-0001-K7).
# Opcional (si está vacía usa NEXTAUTH_SECRET). En producción fíjala y no la cambies.
# El QR del certificado apunta a NEXTAUTH_URL/verificar/<código>: en la nube pon ahí el dominio real.
CERTIFICADOS_SECRET=""
